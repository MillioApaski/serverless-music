{
  "name": "serverless-music",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker:dev": "wrangler dev --local --env local",
    "deploy": "pnpm build && wrangler deploy --env=\"\"",
    "poc": "node --import tsx scripts/run-poc.ts",
    "test:e2e": "pnpm build && playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "quickjs-emscripten": "0.32.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261117.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.47.0"
  }
}
