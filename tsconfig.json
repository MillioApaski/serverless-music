{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "@cloudflare/workers-types",
      "vite/client"
    ],
    "noEmit": true
  },
  "include": [
    "apps",
    "packages",
    "tests",
    "scripts",
    "*.ts"
  ]
}
