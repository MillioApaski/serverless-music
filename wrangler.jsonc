{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serverless-music",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory":"dist/client","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":true},
  "vars": {"APP_ENV":"production","ACCESS_ISSUER":"","ACCESS_AUD":""},
  "env": {"local":{"workers_dev":false,"vars":{"APP_ENV":"local","DEV_IDENTITY":"local-poc-user"}}}
}
